{
  "name": "open-browser",
  "version": "1.1.0",
  "description": "AI-powered autonomous web browsing library for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.0",
    "@ai-sdk/google": "^1.1.0",
    "@ai-sdk/openai": "^1.1.0",
    "ai": "^4.2.0",
    "dotenv": "^16.5.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.0",
    "playwright": "^1.51.0",
    "turndown": "^7.2.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
